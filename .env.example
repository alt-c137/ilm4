DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me

# === ДЕВ (WSL) ===
# Пока Docker-интеграция не включена — работает SQLite (строка ниже закомментирована).
# Включишь Docker Desktop → Settings → Resources → WSL Integration → Ubuntu,
# поднимешь `docker compose up -d` — раскомментируй:
# DATABASE_URL=postgis://ilm4:ilm4@localhost:5432/ilm4

# === ПРОД (VPS, docker-compose.prod.yml) ===
# POSTGRES_PASSWORD=придумай-сильный-пароль
# POSTGRES_DB=ilm4
# POSTGRES_USER=ilm4
# ALLOWED_HOSTS=123.45.67.89,ilm4.com,www.ilm4.com
# CSRF_TRUSTED_ORIGINS=https://ilm4.com,https://www.ilm4.com
# DEBUG=False
# Включить, когда сайт открывается по https (Cloudflare): редирект на https, secure-куки, HSTS
# SECURE_SSL=True

# Почта — письма «восстановить пароль». Любой SMTP: Brevo, Mailgun, Яндекс 360, Gmail (пароль приложения)
# EMAIL_URL=smtp+tls://логин:пароль@smtp-relay.brevo.com:587
# DEFAULT_FROM_EMAIL=ilm4 <noreply@ilm4.com>

# Вход через Google: Google Cloud Console → APIs & Services → Credentials →
# Create OAuth client ID (Web). Authorized redirect URI:
#   https://ilm4.com/accounts/google/callback/   (и http://127.0.0.1:8000/accounts/google/callback/ для дева)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Шифрование переписки в базе. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ХРАНИТЕ КОПИЮ КЛЮЧА: без него старые сообщения не прочитать.
# CHAT_ENCRYPTION_KEY=

# Пополнение баланса (apps/payments). Способ появляется на /wallet/topup/, когда заданы ключи.
# Telegram Stars — ключи не нужны (достаточно TELEGRAM_BOT_TOKEN), курс звезды — в админке.
# Click (Uzcard/Humo): merchant.click.uz → сервис → Service ID, Merchant ID, Secret key
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
# Stripe (Visa/Mastercard мира, Apple/Google Pay): dashboard.stripe.com → Developers
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Криптовалюта (NOWPayments): account.nowpayments.io → Settings → API key, IPN secret
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=

# Telegram: никях как мини-приложение + уведомления. @BotFather → /newbot → токен;
# /setmenubutton → https://ilm4.com/nikah/
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=ilm4_nikah_bot
# SITE_URL=https://ilm4.com
# Группа модераторов: добавить бота в группу, написать /id — бот ответит числом
# TELEGRAM_MODERATION_CHAT_ID=-100...
# Кто может одобрять (Telegram id через запятую; свой id — написать боту /id). Пусто — все в группе
# TELEGRAM_MODERATOR_IDS=
# Сервер: секрет вебхука (любая длинная случайная строка)
# TELEGRAM_WEBHOOK_SECRET=
